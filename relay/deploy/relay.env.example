# Devdy Relay environment (example). Copy to /etc/devdy-relay.env, set a strong
# token, and chmod 0640. NEVER commit the real file (SEC-001).

# REQUIRED. Shared secret the Host authenticates with (register_host.auth_token).
# Generate e.g.: openssl rand -hex 32
RELAY_HOST_TOKEN=change-me-to-a-strong-random-secret

# Bind address. Topology B: localhost only; TLS is terminated by the proxy.
RELAY_BIND=127.0.0.1:8787

# Anti-flood limit for control frames (register/create_pair/join/...) per
# window (SEC-007). Data frames and keepalives are not limited.
RELAY_RATE_LIMIT_MAX=60
RELAY_RATE_LIMIT_WINDOW_SECS=10

# The relay pings every connection at this cadence (browsers answer natively,
# even in a background tab) and closes any connection that delivers no bytes
# for RELAY_PEER_LIVENESS_TIMEOUT_SECS. That close is what tears down a dead
# Host's listen or a dead phone's room, so both sides re-join quickly.
RELAY_PING_INTERVAL_SECS=15
RELAY_PEER_LIVENESS_TIMEOUT_SECS=45

# Log verbosity (metadata only; payloads are never logged).
RUST_LOG=info
