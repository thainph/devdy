# Devdy Relay environment (example). Copy to /etc/devdy-relay.env, set a strong
# token, and chmod 0640. NEVER commit the real file (SEC-001).

# REQUIRED. Shared secret the Host authenticates with (register_host.auth_token).
# Generate e.g.: openssl rand -hex 32
RELAY_HOST_TOKEN=change-me-to-a-strong-random-secret

# Bind address. Topology B: localhost only; TLS is terminated by the proxy.
RELAY_BIND=127.0.0.1:8787

# Pairing code TTL in seconds (SRS constant PAIR_TTL = 60).
PAIR_TTL_SECS=60

# Coarse anti-flood limit at the relay edge (SEC-007): frames per window.
RELAY_RATE_LIMIT_MAX=60
RELAY_RATE_LIMIT_WINDOW_SECS=10

# Close an ACTIVE room after this many seconds with no traffic.
RELAY_ROOM_IDLE_TIMEOUT_SECS=3600

# Per-peer liveness: treat a Host or Controller as dropped if it sends no frame
# (data or keepalive) for this many seconds, even without a TCP close. This is
# the relay's authoritative detector for half-open sockets (mobile network drop,
# laptop sleep). Sized at ~3x the client keepalive cadence (15s) so a lost beat
# or two never trips it. When a Controller is dropped this way the room is kept
# for RELAY_RECONNECT_WINDOW_SECS so the phone can resume.
RELAY_PEER_LIVENESS_TIMEOUT_SECS=45

# Log verbosity (metadata only; payloads are never logged).
RUST_LOG=info
